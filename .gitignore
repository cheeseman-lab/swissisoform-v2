__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.ipynb_checkpoints/
.env
.venv/
*.log
.DS_Store
.pytest_cache/
.ruff_cache/
# Typst compilation output — regenerate from sources
docs/methods/*.pdf
.claude/
.torch_cache/
data/reference/
data/output/*
# Slurm job logs — transient; keep the dir (sbatch --output needs it) via .gitkeep
logs/*
!logs/.gitkeep
# Runtime caches (PepQuery2 validated-peptide JSON, etc.)
data/cache/
.cache/
# Tempdirs from precompute_* when a run exits without cleanup (now under .cache/tmp)
pepquery_*/
deeploc_*/
signalp_*/
targetp_*/
interproscan_*/
tmp_pq/
tmp_signalp/
# Nextflow + Singularity caches (InterProScan 6): tens of GB, regenerable
.nextflow/
.singularity_cache/
# Most internal docs are untracked (reviews, specs, handoffs, superpowers).
# Tracked: docs/methods/ (paper source), docs/architecture/ (current-state scoping
# docs), docs/plans/ (feature plans) — see "Scope Before Plan" in CLAUDE.md.
docs/*
!docs/methods/
docs/methods/*.pdf
!docs/architecture/
!docs/plans/
.superpowers/

# regression baselines (re-derivable from a 13-gene run)
tests/regression/baseline/
