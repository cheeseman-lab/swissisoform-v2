__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.ipynb_checkpoints/
.env
.venv/
*.log
.DS_Store
.pytest_cache/
.ruff_cache/
# Typst compilation output — regenerate from sources
docs/methods/*.pdf
.claude/
.torch_cache/
data/reference/
data/output/*
# Slurm job logs — transient; keep the dir (sbatch --output needs it) via .gitkeep
logs/*
!logs/.gitkeep
# Runtime caches (PepQuery2 validated-peptide JSON, etc.)
data/cache/
.cache/
# Tempdirs from precompute_* when a run exits without cleanup (now under .cache/tmp)
pepquery_*/
deeploc_*/
signalp_*/
targetp_*/
interproscan_*/
tmp_pq/
tmp_signalp/
# Nextflow + Singularity caches (InterProScan 6): tens of GB, regenerable
.nextflow/
.singularity_cache/
# Internal docs are untracked — ONLY docs/methods/ (the paper source) is tracked.
# Ignore everything else under docs/ (reviews, plans, architecture, analysis,
# handoffs, superpowers); the "Scope Before Plan" docs live here locally.
docs/*
!docs/methods/
docs/methods/*.pdf
.superpowers/

# Generated analysis reports (regenerable from the sourceseq tool) — not source.
data/reports/

# Source-transcript-resolution PRODUCTION tool (Elizabeth's workstream): read
# alignment + quantification (salmon/minimap2/IsoQuant) + the window-purity /
# expression-disambiguation library, drivers, and tests. Self-contained and
# gitignored — it outputs the resolved per-TIS source-mRNA dataset to its final
# data/ locations. The tracked repo only *integrates* that output (see CLAUDE.md
# "Source-transcript resolution"). Preserved on disk + in git history.
sourceseq/

# regression baselines (re-derivable from a 13-gene run)
tests/regression/baseline/
