__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.ipynb_checkpoints/
.env
.venv/
*.log
.DS_Store
.pytest_cache/
.ruff_cache/
# Typst compilation output — regenerate from sources
docs/methods/*.pdf
.claude/
.torch_cache/
data/reference/
data/output/*
# Except the 5-gene E2E all-paired parquet — checked in so reviewers can
# inspect actual per-TIS module outputs without re-running the pipeline.
!data/output/5gene_e2e/
data/output/5gene_e2e/*
!data/output/5gene_e2e/all_paired.parquet
# Slurm job logs — transient; keep the dir (sbatch --output needs it) via .gitkeep
logs/*
!logs/.gitkeep
# Runtime caches (PepQuery2 validated-peptide JSON, etc.)
data/cache/
.cache/
# Tempdirs from precompute_* when a run exits without cleanup (now under .cache/tmp)
pepquery_*/
deeploc_*/
signalp_*/
targetp_*/
interproscan_*/
tmp_pq/
tmp_signalp/
# Nextflow + Singularity caches (InterProScan 6): tens of GB, regenerable
.nextflow/
.singularity_cache/
# Internal docs are untracked — ONLY docs/methods/ (the paper source) is tracked.
# Ignore everything else under docs/ (reviews, plans, specs, handoffs, superpowers).
docs/*
!docs/methods/
docs/methods/*.pdf
.superpowers/

# regression baselines (re-derivable from a 13-gene run)
tests/regression/baseline/
