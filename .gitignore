__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.ipynb_checkpoints/
.env
.venv/
*.log
.DS_Store
.pytest_cache/
.ruff_cache/
# Typst compilation output — regenerate from sources
docs/methods/*.pdf
.claude/
.torch_cache/
# Slurm job logs — transient; keep the dir (sbatch --output needs it) via .gitkeep
logs/*
!logs/.gitkeep
# Runtime caches (PepQuery2 validated-peptide JSON, etc.)
data/cache/
.cache/
# Tempdirs from precompute_* when a run exits without cleanup (now under .cache/tmp)
pepquery_*/
deeploc_*/
signalp_*/
targetp_*/
interproscan_*/
tmp_pq/
tmp_signalp/
# Nextflow + Singularity caches (InterProScan 6): tens of GB, regenerable
.nextflow/
.singularity_cache/
# Per-shard NXF_HOME, one per annotate array task (annotate_array.sbatch).
# Same content as .nextflow/ (framework jar + pipeline assets), ~40 MB each.
.nextflow_shards/
# Internal docs are untracked — ONLY docs/methods/ (the paper source) is tracked.
# Ignore everything else under docs/ (reviews, plans, architecture, analysis,
# handoffs, superpowers); the "Scope Before Plan" docs live here locally.
docs/*
!docs/methods/
docs/methods/*.pdf
.superpowers/

# Do not include data or reference files in the commit.
data/

# Source-transcript-resolution read-alignment tool (Elizabeth's workstream):
# salmon / minimap2 / IsoQuant / SRA mapping + envs + download scripts only. It
# writes quantifications (quant.sf / transcript_counts.tsv) to data/reference/ —
# the "processed data in". The disambiguation *science* is tracked filtering
# (src/swissisoform/sourceresolve/, run per-sample in run_sample); see CLAUDE.md
# "Source-transcript resolution". Gitignored, preserved on disk + git history.
sourceseq/

# Method-development analysis (gitignored, re-derivable): the disambiguation
# QC / benchmark / plot / report drivers + the original sourceseq library, moved
# out of sourceseq/ when the resolution logic became tracked filtering.
analysis/

# regression baselines (re-derivable from a 13-gene run)
tests/regression/baseline/

# personal local run wrapper (hardcoded paths) — keep out of repo
scripts/_run_cheeseman13.sh
scripts/export
# local-only backfill (DeepLoc/SignalP/InterProScan from snapshot until those envs exist)
scripts/_backfill_cols.py
# Validation / diagnostic scratch (this session) — transient
.scratch/
