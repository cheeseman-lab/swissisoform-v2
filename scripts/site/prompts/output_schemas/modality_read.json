{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModalityRead",
  "type": "object",
  "additionalProperties": false,
  "required": ["modality", "axis", "headline", "summary", "criteria_cited", "confidence"],
  "properties": {
    "modality": {
      "type": "string",
      "enum": ["cell_lines", "conservation", "variants", "mass_spec", "structure", "domains_motifs", "localization"]
    },
    "axis": {"type": "string", "enum": ["existence", "functional"]},
    "headline": {"type": "string", "minLength": 1, "maxLength": 200},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1200},
    "criteria_cited": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 0
    },
    "confidence": {"type": "string", "enum": ["high", "medium", "low", "n/a"]}
  }
}
