{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SynthesisRead",
  "type": "object",
  "additionalProperties": false,
  "required": ["tis_id", "headline", "narrative", "key_findings", "caveats"],
  "properties": {
    "tis_id": {"type": "string", "minLength": 1},
    "headline": {"type": "string", "minLength": 1, "maxLength": 200},
    "narrative": {"type": "string", "minLength": 1, "maxLength": 4000},
    "key_findings": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "maxItems": 8
    },
    "caveats": {"type": "string", "minLength": 0, "maxLength": 1000}
  }
}
